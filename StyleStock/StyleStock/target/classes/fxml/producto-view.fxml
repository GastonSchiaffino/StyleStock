<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.style.stock.controller.ProductoController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
    </padding>

    <!-- Barra de título y búsqueda -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="GESTIÓN DE PRODUCTOS" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:"/>
        <TextField fx:id="txtBuscar" promptText="Buscar por descripción..." prefWidth="250"/>
        <Button text="Stock Bajo" onAction="#mostrarStockBajo" styleClass="button"/>
    </HBox>

    <Separator/>

    <!-- Formulario de producto -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Código:"/>
        <TextField fx:id="txtCodigo" promptText="Código" prefWidth="120"/>
        
        <Label text="Descripción:"/>
        <TextField fx:id="txtDescripcion" promptText="Descripción" prefWidth="250"/>
        
        <Label text="Precio:"/>
        <TextField fx:id="txtPrecio" promptText="0.00" prefWidth="100"/>
        
        <Label text="Stock:"/>
        <TextField fx:id="txtStock" promptText="0" prefWidth="80"/>
        
        <Label text="Stock Mín:"/>
        <TextField fx:id="txtStockMinimo" text="5" prefWidth="80"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Categoría:"/>
        <TextField fx:id="txtCategoria" promptText="Categoría (opcional)" prefWidth="200"/>
        
        <Pane HBox.hgrow="ALWAYS"/>
        
        <Button fx:id="btnNuevo" text="Nuevo" onAction="#nuevoProducto" styleClass="button"/>
        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarProducto" styleClass="button"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#editarProducto" styleClass="button"/>
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar" styleClass="button"/>
    </HBox>

    <Separator/>

    <!-- Tabla de productos -->
    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="120"/>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
            <TableColumn fx:id="colStockMinimo" text="Stock Mín." prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Barra inferior con botones -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30" prefHeight="30"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEliminar" text="Eliminar Seleccionado" onAction="#eliminarProducto" styleClass="button"/>
    </HBox>
</VBox>
