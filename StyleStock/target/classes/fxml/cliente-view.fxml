<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.style.stock.controller.ClienteController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
    </padding>

    <!-- Barra de título y búsqueda -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="GESTIÓN DE CLIENTES" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:"/>
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre..." prefWidth="250"/>
    </HBox>

    <Separator/>

    <!-- Formulario de cliente -->
    <GridPane hgap="10" vgap="10">
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Nombre completo" prefWidth="300" 
                   GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="3"/>

        <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtDireccion" promptText="Dirección" prefWidth="300"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3"/>

        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtTelefono" promptText="Teléfono" prefWidth="150"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="CUIT:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <TextField fx:id="txtCuit" promptText="XX-XXXXXXXX-X" prefWidth="150"
                   GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtEmail" promptText="email@ejemplo.com" prefWidth="250"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="2"/>
    </GridPane>

    <!-- Botones de acción -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevo" text="Nuevo" onAction="#nuevoCliente" styleClass="button"/>
        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarCliente" styleClass="button"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#editarCliente" styleClass="button"/>
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar" styleClass="button"/>
    </HBox>

    <Separator/>

    <!-- Tabla de clientes -->
    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
            <TableColumn fx:id="colCuit" text="CUIT" prefWidth="130"/>
        </columns>
    </TableView>

    <!-- Barra inferior -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30" prefHeight="30"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEliminar" text="Eliminar Seleccionado" onAction="#eliminarCliente" styleClass="button"/>
    </HBox>
</VBox>

