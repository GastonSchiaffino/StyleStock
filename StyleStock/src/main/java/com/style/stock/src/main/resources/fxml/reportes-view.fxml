<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import java.lang.String?>
<VBox spacing="15" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.style.stock.controller.ReportesController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Título -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="REPORTES Y ESTADÍSTICAS" 
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblFechaActual" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
    </HBox>

    <Separator/>

    <!-- Tarjetas de Resumen -->
    <GridPane hgap="15" vgap="15">
        <!-- Card 1: Ventas Hoy -->
        <VBox spacing="5" styleClass="card" 
              style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 8;"
              GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Ventas de Hoy" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label fx:id="lblVentasHoy" text="0.00"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
            <Label fx:id="lblCantVentasHoy" text="0 ventas" 
                   style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
        </VBox>

        <!-- Card 2: Ventas del Mes -->
        <VBox spacing="5" styleClass="card"
              style="-fx-background-color: #E8F5E9; -fx-padding: 15; -fx-background-radius: 8;"
              GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Ventas del Mes" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label fx:id="lblVentasMes" text="0.00"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #388E3C;"/>
            <Label fx:id="lblCantVentasMes" text="0 ventas" 
                   style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
        </VBox>

        <!-- Card 3: Stock Bajo -->
        <VBox spacing="5" styleClass="card"
              style="-fx-background-color: #FFF3E0; -fx-padding: 15; -fx-background-radius: 8;"
              GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="Stock Bajo" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label fx:id="lblStockBajo" text="0" 
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F57C00;"/>
            <Label text="productos" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
        </VBox>

        <!-- Card 4: Total Productos -->
        <VBox spacing="5" styleClass="card"
              style="-fx-background-color: #F3E5F5; -fx-padding: 15; -fx-background-radius: 8;"
              GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label text="Total Variantes" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label fx:id="lblTotalVariantes" text="0" 
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #7B1FA2;"/>
            <Label text="activas" style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
        </VBox>
    </GridPane>

    <Separator/>

    <!-- Filtros de Reportes -->
    <TitledPane text="Filtros" collapsible="false">
        <GridPane hgap="15" vgap="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <Label text="Desde:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <DatePicker fx:id="dpDesde" prefWidth="150" 
                        GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Hasta:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <DatePicker fx:id="dpHasta" prefWidth="150" 
                        GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cbCategoria" promptText="Todas" prefWidth="150"
                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Cliente:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cbCliente" promptText="Todos" prefWidth="150"
                      GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <HBox spacing="10" alignment="CENTER_LEFT" 
                  GridPane.columnIndex="4" GridPane.rowIndex="0" GridPane.rowSpan="2">
                <Button text="Aplicar Filtros" onAction="#aplicarFiltros" 
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;" 
                        styleClass="button"/>
                <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="button"/>
            </HBox>
        </GridPane>
    </TitledPane>

    <!-- Tabs de Reportes -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        
        <!-- TAB: Ventas por Período -->
        <Tab text="📊 Ventas por Período">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Exportar a Excel" onAction="#exportarVentas" styleClass="button"/>
                    <Button text="Imprimir" onAction="#imprimirVentas" styleClass="button"/>
                </HBox>

                <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colVentaNumero" text="Número" prefWidth="120"/>
                        <TableColumn fx:id="colVentaFecha" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colVentaCliente" text="Cliente" prefWidth="200"/>
                        <TableColumn fx:id="colVentaTipo" text="Tipo" prefWidth="80"/>
                        <TableColumn fx:id="colVentaItems" text="Items" prefWidth="60"/>
                        <TableColumn fx:id="colVentaTotal" text="Total" prefWidth="100"/>
                        <TableColumn fx:id="colVentaEstado" text="Estado" prefWidth="90"/>
                    </columns>
                </TableView>

                <HBox spacing="20" alignment="CENTER_RIGHT">
                    <Label text="Total del Período:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label fx:id="lblTotalPeriodo" text="0.00"
                           style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2E7D32;"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- TAB: Productos Más Vendidos -->
        <Tab text="🏆 Productos Más Vendidos">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Top:"/>
                    <ComboBox fx:id="cbTopProductos" value="10">
                        <items>
                            <javafx.collections.FXCollections fx:factory="observableArrayList">
                                <String fx:value="5"/>
                                <String fx:value="10"/>
                                <String fx:value="20"/>
                                <String fx:value="50"/>
                            </javafx.collections.FXCollections>
                        </items>
                    </ComboBox>
                    <Button text="Actualizar" onAction="#actualizarTopProductos" styleClass="button"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="Exportar" onAction="#exportarTopProductos" styleClass="button"/>
                </HBox>

                <TableView fx:id="tablaTopProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTopPosicion" text="Pos." prefWidth="50"/>
                        <TableColumn fx:id="colTopSku" text="SKU" prefWidth="120"/>
                        <TableColumn fx:id="colTopProducto" text="Producto" prefWidth="250"/>
                        <TableColumn fx:id="colTopCantidad" text="Cantidad" prefWidth="80"/>
                        <TableColumn fx:id="colTopIngresos" text="Ingresos" prefWidth="120"/>
                        <TableColumn fx:id="colTopPorcentaje" text="'%' del Total" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB: Stock Valorizado -->
        <Tab text="💰 Stock Valorizado">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Calcular Valorización" onAction="#calcularValorizacion"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;" 
                            styleClass="button"/>
                    <Button text="Exportar" onAction="#exportarValorizacion" styleClass="button"/>
                </HBox>

                <TableView fx:id="tablaValorizacion" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colValSku" text="SKU" prefWidth="120"/>
                        <TableColumn fx:id="colValProducto" text="Producto" prefWidth="250"/>
                        <TableColumn fx:id="colValStock" text="Stock" prefWidth="70"/>
                        <TableColumn fx:id="colValCosto" text="Costo Unit." prefWidth="100"/>
                        <TableColumn fx:id="colValTotal" text="Total Costo" prefWidth="120"/>
                        <TableColumn fx:id="colValPrecio" text="Precio Venta" prefWidth="100"/>
                        <TableColumn fx:id="colValPotencial" text="Valor Potencial" prefWidth="120"/>
                    </columns>
                </TableView>

                <GridPane hgap="20" vgap="5" style="-fx-background-color: #F5F5F5; -fx-padding: 10;">
                    <Label text="Total Inversión en Stock:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="lblTotalInversion" text="0.00"
                           style="-fx-font-weight: bold; -fx-text-fill: #D32F2F;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Valor Potencial de Venta:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="lblValorPotencial" text="0.00"
                           style="-fx-font-weight: bold; -fx-text-fill: #388E3C;"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Ganancia Potencial:" style="-fx-font-weight: bold; -fx-font-size: 14px;"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="lblGananciaPotencial" text="0.00"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1976D2;"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>
        </Tab>

        <!-- TAB: Movimientos de Stock -->
        <Tab text="📦 Movimientos de Stock">
            <VBox spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Variante:"/>
                    <ComboBox fx:id="cbVarianteMovimientos" promptText="Todas" prefWidth="250"/>
                    <Label text="Tipo:"/>
                    <ComboBox fx:id="cbTipoMovimiento" prefWidth="120">
                        <items>
                            <javafx.collections.FXCollections fx:factory="observableArrayList">
                                <String fx:value="TODOS"/>
                                <String fx:value="VENTA"/>
                                <String fx:value="INGRESO"/>
                                <String fx:value="AJUSTE"/>
                                <String fx:value="DEVOLUCION"/>
                            </javafx.collections.FXCollections>
                        </items>
                    </ComboBox>
                    <Button text="Buscar" onAction="#buscarMovimientos" styleClass="button"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="Exportar" onAction="#exportarMovimientos" styleClass="button"/>
                </HBox>

                <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMovId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colMovFecha" text="Fecha/Hora" prefWidth="150"/>
                        <TableColumn fx:id="colMovVariante" text="Variante" prefWidth="200"/>
                        <TableColumn fx:id="colMovTipo" text="Tipo" prefWidth="100"/>
                        <TableColumn fx:id="colMovCantidad" text="Cantidad" prefWidth="80"/>
                        <TableColumn fx:id="colMovStockAnt" text="Stock Ant." prefWidth="80"/>
                        <TableColumn fx:id="colMovStockNuevo" text="Stock Nuevo" prefWidth="90"/>
                        <TableColumn fx:id="colMovReferencia" text="Referencia" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

    <!-- Barra de Progreso -->
    <HBox alignment="CENTER" spacing="10">
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30" prefHeight="30"/>
        <Label fx:id="lblEstadoCarga" text="" style="-fx-text-fill: #666;"/>
    </HBox>
</VBox>