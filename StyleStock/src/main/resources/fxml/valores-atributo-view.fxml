<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.style.stock.controller.ValorAtributoController"
      prefWidth="600" prefHeight="500">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Título con info del atributo -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="VALORES DE ATRIBUTO:"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label fx:id="lblAtributoNombre"
               style="-fx-font-size: 16px; -fx-text-fill: #2196F3; -fx-font-weight: bold;"/>
    </HBox>

    <Separator/>

    <!-- Formulario para agregar valor -->
    <VBox spacing="10" style="-fx-background-color: #F5F5F5; -fx-padding: 15; -fx-background-radius: 5;">
        <Label text="Agregar Nuevo Valor" style="-fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="10">
            <Label text="Valor:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtValor" promptText="Ej: 36, XL, Rojo..."
                       prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

           <Label fx:id="lblCodigoHex" text="Código Hex:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <HBox spacing="5" alignment="CENTER_LEFT"
                  GridPane.columnIndex="3" GridPane.rowIndex="0">
                <TextField fx:id="txtCodigoHexField" promptText="#FFFFFF" prefWidth="100" />
                <ColorPicker fx:id="colorPickerControl" prefWidth="50" />
            </HBox>

            <Label text="Orden:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtOrden" text="0" prefWidth="80"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Agregar" onAction="#agregarValor"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                    styleClass="button"/>
            <Button text="Limpiar" onAction="#limpiarFormulario" styleClass="button"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Tabla de valores -->
    <Label text="Valores Existentes:" style="-fx-font-weight: bold;"/>

    <TableView fx:id="tablaValores" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colValor" text="Valor" prefWidth="200"/>
            <TableColumn fx:id="colCodigoHex" text="Color" prefWidth="100"/>
            <TableColumn fx:id="colOrden" text="Orden" prefWidth="80"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="80"/>
        </columns>
    </TableView>

    <!-- Botones de acción -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <ProgressIndicator fx:id="progressIndicator" visible="false"
                           prefWidth="30" prefHeight="30"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Editar Seleccionado" onAction="#editarValor" styleClass="button"/>
        <Button text="Eliminar Seleccionado" onAction="#eliminarValor"
                style="-fx-background-color: #f44336; -fx-text-fill: white;"
                styleClass="button"/>
        <Button text="Cerrar" onAction="#cerrar" styleClass="button"/>
    </HBox>

    <!-- Ayuda -->
    <HBox style="-fx-background-color: #E3F2FD; -fx-padding: 10; -fx-background-radius: 5;">
        <Label text="💡 Tip: Los valores se usan para crear variantes. Ej: Talle → 36, 37, 38..."
               style="-fx-text-fill: #1976D2; -fx-font-size: 11px;" wrapText="true"/>
    </HBox>
</VBox>