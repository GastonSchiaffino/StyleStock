<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.style.stock.controller.FacturaController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Título -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="NUEVA FACTURA" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevo" text="Nueva Factura" onAction="#nuevaFactura" styleClass="button"/>
    </HBox>

    <Separator/>

    <!-- Datos de la factura -->
    <VBox spacing="10">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Cliente:"/>
            <ComboBox fx:id="cbClientes" promptText="Seleccione un cliente" prefWidth="300"/>
            <Label text="Tipo:"/>
            <ComboBox fx:id="cbTipoFactura" prefWidth="80"/>
            <Label text="Fecha:"/>
            <DatePicker fx:id="dpFecha" prefWidth="130"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Notas:"/>
            <TextArea fx:id="txtNotas" promptText="Notas adicionales (opcional)"
                      prefHeight="60" prefWidth="500"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Agregar productos -->
    <Label text="Agregar Productos" style="-fx-font-weight: bold;"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Producto:"/>
        <ComboBox fx:id="cbProductos" promptText="Seleccione producto" prefWidth="300"/>
        <Label text="Cantidad:"/>
        <TextField fx:id="txtCantidad" promptText="1" prefWidth="80"/>
        <Button fx:id="btnAgregar" text="Agregar" onAction="#agregarItem" styleClass="button"/>
        <Button fx:id="btnEliminarItem" text="Quitar Seleccionado" onAction="#eliminarItem" styleClass="button"/>
    </HBox>

    <!-- Tabla de items -->
    <TableView fx:id="tablaItems" VBox.vgrow="ALWAYS" prefHeight="250">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="120"/>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300"/>
            <TableColumn fx:id="colPrecio" text="Precio Unit." prefWidth="100"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="100"/>
        </columns>
    </TableView>

    <Separator/>

    <!-- Totales - USANDO REGIÓN PARA ESPACIADO -->
    <VBox spacing="8" alignment="CENTER_RIGHT" style="-fx-padding: 0 50 0 0;">
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Descuento:"/>
            <TextField fx:id="txtDescuento" text="0" prefWidth="100"/>
        </HBox>

        <HBox spacing="40" alignment="CENTER_RIGHT">
            <Label text="Subtotal:" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblSubtotal" text="0.00" style="-fx-font-weight: bold;" minWidth="100"/>
        </HBox>

        <HBox spacing="40" alignment="CENTER_RIGHT">
            <Label text="Descuento:" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblDescuento" text="0.00" style="-fx-font-weight: bold;" minWidth="100"/>
        </HBox>

        <HBox spacing="40" alignment="CENTER_RIGHT">
            <Label text="TOTAL:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotal" text="0.00"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                   minWidth="100"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Botones finales -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30" prefHeight="30"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnPDF" text="Generar PDF" onAction="#generarPDFActual" styleClass="button"/>
        <Button fx:id="btnGuardar" text="Guardar Factura" onAction="#guardarFactura"
                styleClass="button" style="-fx-background-color: #2E7D32; -fx-text-fill: white;"/>
    </HBox>
</VBox>