<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.style.stock.controller.ProductoVarianteController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- ============================================ -->
    <!-- HEADER -->
    <!-- ============================================ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="PRODUCTOS Y VARIANTES"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Stock Bajo" onAction="#mostrarStockBajo"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;" styleClass="button"/>
    </HBox>

    <Separator/>

    <!-- ============================================ -->
    <!-- PANEL PRINCIPAL: SPLIT VERTICAL -->
    <!-- ============================================ -->
    <SplitPane orientation="VERTICAL" dividerPositions="0.4" VBox.vgrow="ALWAYS">

        <!-- ============================================ -->
        <!-- PARTE SUPERIOR: PRODUCTOS -->
        <!-- ============================================ -->
        <VBox spacing="10">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="PRODUCTOS (Modelos Base)"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNuevoProducto" text="+ Nuevo Producto"
                        onAction="#nuevoProducto"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;"
                        styleClass="button"/>
            </HBox>

            <!-- FILTROS DE PRODUCTOS -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🔍 FILTROS:" style="-fx-font-weight: bold;"/>
                <Label text="Categoría:"/>
                <ComboBox fx:id="cbFiltroCategoria" promptText="Todas"
                          prefWidth="150" onAction="#aplicarFiltrosProductos"/>

                <!-- Búsqueda de productos -->
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Código o nombre..." prefWidth="200"/>
                <Button text="🗑 Limpiar" onAction="#limpiarFiltrosProductos" styleClass="button"/>
            </HBox>

            <!-- TABLA DE PRODUCTOS -->
            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProdId" text="ID" prefWidth="40"/>
                    <TableColumn fx:id="colProdCodigo" text="Código" prefWidth="100"/>
                    <TableColumn fx:id="colProdNombre" text="Nombre" prefWidth="250"/>
                    <TableColumn fx:id="colProdCategoria" text="Categoría" prefWidth="120"/>
                    <TableColumn fx:id="colProdMarca" text="Marca" prefWidth="100"/>
                    <TableColumn fx:id="colProdPrecioMin" text="P. Minorista" prefWidth="100"/>
                    <TableColumn fx:id="colProdPrecioMay" text="P. Mayorista" prefWidth="100"/>
                    <TableColumn fx:id="colProdVariantes" text="Variantes" prefWidth="80"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnEditarProducto" text="Editar Producto"
                        onAction="#editarProducto" styleClass="button"/>
                <Button fx:id="btnEliminarProducto" text="Eliminar Producto"
                        onAction="#eliminarProducto"
                        style="-fx-background-color: #f44336; -fx-text-fill: white;"
                        styleClass="button"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblInfoProducto"
                       text="Seleccione un producto para ver sus variantes"
                       style="-fx-text-fill: #666; -fx-font-style: italic;"/>
            </HBox>
        </VBox>

        <!-- ============================================ -->
        <!-- PARTE INFERIOR: VARIANTES DEL PRODUCTO SELECCIONADO -->
        <!-- ============================================ -->
        <VBox spacing="10">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #E3F2FD; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="VARIANTES DEL PRODUCTO:"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label fx:id="lblProductoSeleccionado" text="Ninguno"
                       style="-fx-font-size: 14px; -fx-text-fill: #1976D2; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNuevaVariante" text="+ Nueva Variante"
                        onAction="#nuevaVariante"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;"
                        styleClass="button"
                        disable="true"/>
            </HBox>

            <!-- FILTROS DE VARIANTES -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🔍 FILTROS:" style="-fx-font-weight: bold;"/>
                <Label text="Atributo:"/>
                <ComboBox fx:id="cbFiltroAtributo" promptText="Todos" prefWidth="120" onAction="#cargarValoresAtributoFiltro"/>
                <Label text="Valor:"/>
                <ComboBox fx:id="cbFiltroValorAtributo" promptText="Todos" prefWidth="120" onAction="#aplicarFiltrosVariantes"/>
                <Button text="🗑 Limpiar" onAction="#limpiarFiltrosVariantes" styleClass="button"/>
            </HBox>
            <!-- TABLA DE VARIANTES -->
            <TableView fx:id="tablaVariantes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colVarId" text="ID" prefWidth="40"/>
                    <TableColumn fx:id="colVarSku" text="SKU" prefWidth="130"/>
                    <TableColumn fx:id="colVarPrecioCosto" text="Costo" prefWidth="90"/>
                    <TableColumn fx:id="colVarPrecioMin" text="P. Minorista" prefWidth="100"/>
                    <TableColumn fx:id="colVarPrecioMay" text="P. Mayorista" prefWidth="100"/>
                    <TableColumn fx:id="colVarStock" text="Stock" prefWidth="70"/>
                    <TableColumn fx:id="colVarStockMin" text="Stock Mín." prefWidth="90"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30;">
                        <Label text="📦" style="-fx-font-size: 48px;"/>
                        <Label text="Seleccione un producto arriba para ver sus variantes"
                               style="-fx-font-size: 14px; -fx-text-fill: #999;"/>
                    </VBox>
                </placeholder>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnAjustarStock" text="Ajustar Stock"
                        onAction="#ajustarStock" styleClass="button" disable="true"/>
                <Button fx:id="btnEditarVariante" text="Editar Variante"
                        onAction="#editarVariante" styleClass="button" disable="true"/>
                <Button fx:id="btnEliminarVariante" text="Eliminar Variante"
                        onAction="#eliminarVariante"
                        style="-fx-background-color: #f44336; -fx-text-fill: white;"
                        styleClass="button" disable="true"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotalVariantes" text="Total variantes: 0"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </SplitPane>

    <!-- ============================================ -->
    <!-- FOOTER -->
    <!-- ============================================ -->
    <HBox alignment="CENTER" spacing="10">
        <ProgressIndicator fx:id="progressIndicator" visible="false"
                           prefWidth="30" prefHeight="30"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="💡 Tip: Haga doble clic en un producto para editar | Click en variante para ver detalles"
               style="-fx-text-fill: #666; -fx-font-size: 11px;"/>
    </HBox>
</VBox>