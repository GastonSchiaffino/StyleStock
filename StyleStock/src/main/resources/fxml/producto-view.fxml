<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.style.stock.controller.ProductoController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15" />
    </padding>

    <!-- Barra de título y búsqueda -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="GESTIÓN DE PRODUCTOS (MODELOS)" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:"/>
        <TextField fx:id="txtBuscar" promptText="Buscar por código o nombre..." prefWidth="250"/>
        <Button text="Ver Variantes" onAction="#mostrarStockBajo" styleClass="button"/>
    </HBox>

    <Separator/>

    <!-- Formulario de producto -->
    <GridPane hgap="10" vgap="10">
        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCodigo" promptText="Código único" prefWidth="120"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtDescripcion" promptText="Nombre del producto" prefWidth="250"
                   GridPane.columnIndex="3" GridPane.rowIndex="0" GridPane.columnSpan="2"/>

        <Label text="Marca:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtMarca" promptText="Marca (opcional)" prefWidth="150"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Categoría:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtCategoria" promptText="Categoría" prefWidth="150"
                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Precio Minorista:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtPrecioMinorista" promptText="0.00" prefWidth="100"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Precio Mayorista:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <TextField fx:id="txtPrecioMayorista" promptText="0.00" prefWidth="100"
                   GridPane.columnIndex="3" GridPane.rowIndex="2"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevo" text="Nuevo" onAction="#nuevoProducto" styleClass="button"/>
        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarProducto" styleClass="button"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#editarProducto" styleClass="button"/>
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar" styleClass="button"/>
    </HBox>

    <Separator/>

    <Label text="NOTA: En v2.0, el stock se maneja por variantes. Use 'Ver Variantes' para gestionar stock."
           style="-fx-text-fill: #FF6600; -fx-font-size: 11px;"/>

    <!-- Tabla de productos -->
    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="120"/>
            <TableColumn fx:id="colDescripcion" text="Nombre" prefWidth="300"/>
            <TableColumn fx:id="colPrecio" text="Precio Min." prefWidth="100"/>
            <TableColumn fx:id="colStock" text="Variantes" prefWidth="80"/>
            <TableColumn fx:id="colStockMinimo" text="Stock Total" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Barra inferior con botones -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30" prefHeight="30"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEliminar" text="Eliminar Seleccionado" onAction="#eliminarProducto" styleClass="button"/>
    </HBox>
</VBox>
