<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.style.stock.controller.VentaController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Título -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="NUEVA VENTA" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancelar" text="Nueva Venta" onAction="#nuevaVenta" styleClass="button"/>
    </HBox>

    <Separator/>

    <!-- DATOS DE LA VENTA -->
    <TitledPane text="Datos de la Venta" collapsible="false">
        <GridPane hgap="15" vgap="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="3">
                <ComboBox fx:id="cbClientes" promptText="Seleccione o busque cliente" prefWidth="300"/>
                <Button fx:id="btnNuevoCliente" text="+ Nuevo Cliente" styleClass="button"/>
            </HBox>

            <Label text="Tipo de Venta:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cbTipoVenta" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Comprobante:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cbTipoComprobante" prefWidth="150" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <DatePicker fx:id="dpFecha" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Notas:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <TextArea fx:id="txtNotas" prefHeight="60" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>
    </TitledPane>

    <!-- AGREGAR PRODUCTOS -->
    <TitledPane text="Agregar Productos" collapsible="false">
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Buscar producto:"/>
                <TextField fx:id="txtBuscarProducto" promptText="SKU o descripción..." prefWidth="300"/>
                <Label text="Cantidad:"/>
                <TextField fx:id="txtCantidad" promptText="1" prefWidth="80"/>
                <Button fx:id="btnAgregarProducto" text="Agregar" onAction="#agregarProducto" 
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;" styleClass="button"/>
            </HBox>

            <ListView fx:id="lvVariantes" prefHeight="100"/>
        </VBox>
    </TitledPane>

    <!-- TABLA DE ITEMS -->
    <TitledPane text="Productos en la Venta" collapsible="false" VBox.vgrow="ALWAYS">
        <VBox spacing="10">
            <TableView fx:id="tablaItems" VBox.vgrow="ALWAYS" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colSKU" text="SKU" prefWidth="150"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300"/>
                    <TableColumn fx:id="colCantidad" text="Cant." prefWidth="60"/>
                    <TableColumn fx:id="colPrecio" text="Precio Unit." prefWidth="100"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="100"/>
                </columns>
            </TableView>
            
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnQuitarItem" text="Quitar Seleccionado" onAction="#quitarItem" 
                        style="-fx-background-color: #f44336; -fx-text-fill: white;" styleClass="button"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- TOTALES Y PAGOS -->
    <HBox spacing="20">
        <!-- TOTALES -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="TOTALES" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Separator/>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Descuento:" prefWidth="100"/>
                <TextField fx:id="txtDescuento" text="0" prefWidth="100"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Subtotal:" prefWidth="100" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblSubtotal" text="0.00" style="-fx-font-weight: bold;" prefWidth="100"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Descuento:" prefWidth="100" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblDescuento" text="0.00" style="-fx-font-weight: bold;" prefWidth="100"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="TOTAL:" prefWidth="100" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="lblTotal" text="0.00"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" prefWidth="100"/>
            </HBox>
        </VBox>

        <!-- PAGOS -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <Label text="PAGOS" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Separator/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Método:"/>
                <ComboBox fx:id="cbMetodoPago" promptText="Seleccione" prefWidth="150"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Monto:"/>
                <TextField fx:id="txtMontoPago" promptText="0.00" prefWidth="100"/>
                <Label text="Cuotas:"/>
                <TextField fx:id="txtCuotas" text="1" prefWidth="60"/>
                <Button fx:id="btnAgregarPago" text="+ Agregar" onAction="#agregarPago" styleClass="button"/>
            </HBox>

            <ListView fx:id="lvPagos" prefHeight="100"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Total Pagado:" prefWidth="100" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblTotalPagado" text="0.00" style="-fx-font-weight: bold; -fx-text-fill: green;" prefWidth="100"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Saldo:" prefWidth="100" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblSaldo" text="0.00" style="-fx-font-weight: bold; -fx-text-fill: red;" prefWidth="100"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- BOTONES DE ACCIÓN -->
    <Separator/>
    <HBox alignment="CENTER_RIGHT" spacing="15">
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30" prefHeight="30"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCompletarVenta" text="COMPLETAR VENTA" onAction="#completarVenta"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 30;" 
                styleClass="button"/>
    </HBox>
</VBox>
