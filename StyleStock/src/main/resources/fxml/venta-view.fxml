<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.style.stock.controller.VentaController"
            style="-fx-background-color: #F5F7FA;">

    <!-- TOP: Datos básicos de venta -->
    <top>
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="NUEVA VENTA" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Fecha:"/>
                <DatePicker fx:id="dpFecha" prefWidth="130"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Tipo:"/>
                <ComboBox fx:id="cbTipoVenta" prefWidth="120"/>
                <Label text="Comprobante:"/>
                <ComboBox fx:id="cbTipoComprobante" prefWidth="120"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Split entre productos (izq) y resumen (der) -->
    <center>
        <SplitPane dividerPositions="0.6">

            <!-- IZQUIERDA: Productos -->
            <VBox spacing="10" style="-fx-padding: 15;">
                <Label text="PRODUCTOS" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                <!-- Búsqueda -->
                <HBox spacing="10">
                    <TextField fx:id="txtBuscarProducto" promptText="Buscar por SKU o descripción..."
                               HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtCantidad" promptText="Cant." prefWidth="60"/>
                    <Button fx:id="btnAgregarProducto" text="+" onAction="#agregarProducto"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"
                            prefWidth="40"/>
                </HBox>

                <!-- Lista de búsqueda -->
                <ListView fx:id="lvVariantes" prefHeight="150"
                          style="-fx-background-color: #FAFAFA;"/>

                <Separator/>

                <!-- Tabla de items -->
                <Label text="ITEMS EN LA VENTA" style="-fx-font-weight: bold;"/>
                <TableView fx:id="tablaItems" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSKU" text="SKU" prefWidth="100"/>
                        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="250"/>
                        <TableColumn fx:id="colCantidad" text="Cant." prefWidth="50"/>
                        <TableColumn fx:id="colPrecio" text="Precio" prefWidth="80"/>
                        <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="80"/>
                    </columns>
                </TableView>

                <HBox spacing="10">
                    <Button fx:id="btnQuitarItem" text="Quitar Seleccionado" onAction="#quitarItem"
                            style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                </HBox>
            </VBox>

            <!-- DERECHA: Cliente, Totales y Pagos -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: white;">
                <VBox spacing="15" style="-fx-padding: 15;">

                    <!-- CLIENTE -->
                    <VBox spacing="8" style="-fx-background-color: #F9FAFB; -fx-padding: 12; -fx-background-radius: 8;">
                        <Label text="CLIENTE" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                        <ComboBox fx:id="cbClientes" promptText="Seleccionar cliente..."
                                  maxWidth="Infinity"/>
                        <Button fx:id="btnNuevoCliente" text="+ Nuevo Cliente" maxWidth="Infinity"
                                style="-fx-background-color: transparent; -fx-border-color: #2196F3; -fx-text-fill: #2196F3;"/>
                    </VBox>

                    <Separator/>

                    <!-- TOTALES -->
                    <VBox spacing="10" style="-fx-background-color: #FFF9C4; -fx-padding: 15; -fx-background-radius: 8;">
                        <Label text="TOTALES" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Descuento:" style="-fx-font-size: 12px;"/>
                            <TextField fx:id="txtDescuento" text="0" alignment="CENTER_RIGHT" maxWidth="Infinity"/>
                        </HBox>

                        <Separator/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Subtotal:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblSubtotal" text="0.00" style="-fx-font-weight: bold;" minWidth="100" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Descuento:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblDescuento" text="0.00" style="-fx-font-weight: bold; -fx-text-fill: #f44336;" minWidth="100" alignment="CENTER_RIGHT"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                            <Label text="TOTAL:" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblTotal" text="0.00"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                                   minWidth="120" alignment="CENTER_RIGHT"/>
                        </HBox>
                    </VBox>

                    <Separator/>

                    <!-- PAGOS -->
                    <VBox spacing="10" style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 8;">
                        <Label text="PAGOS" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>

                        <ComboBox fx:id="cbMetodoPago" promptText="Método de pago" maxWidth="Infinity"/>
                        <TextField fx:id="txtMontoPago" promptText="Monto" HBox.hgrow="ALWAYS"/>
                        <HBox spacing="10">
                            <TextField fx:id="txtCuotas" promptText="Cuotas" text="1" prefWidth="50" />
                        </HBox>

                        <Button fx:id="btnAgregarPago" text="+ Agregar Pago" onAction="#agregarPago" maxWidth="Infinity"
                                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>

                        <ListView fx:id="lvPagos" prefHeight="100" style="-fx-background-color: white;"/>

                        <Separator/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Pagado:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblTotalPagado" text="0.00"
                                   style="-fx-font-weight: bold; -fx-text-fill: #4CAF50;"
                                   minWidth="100" alignment="CENTER_RIGHT"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Saldo:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblSaldo" text="0.00"
                                   style="-fx-font-weight: bold; -fx-text-fill: #f44336;"
                                   minWidth="100" alignment="CENTER_RIGHT"/>
                        </HBox>
                    </VBox>

                    <!-- NOTAS -->
                    <VBox spacing="5">
                        <Label text="Notas (opcional)" style="-fx-font-size: 12px;"/>
                        <TextArea fx:id="txtNotas" prefHeight="60" promptText="Observaciones..."/>
                    </VBox>

                </VBox>
            </ScrollPane>

        </SplitPane>
    </center>

    <!-- BOTTOM: Botones de acción -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 15;">
            <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="30" prefHeight="30"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Nueva Venta" onAction="#nuevaVenta"
                    style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"/>
            <Button fx:id="btnCompletarVenta" text="COMPLETAR VENTA" onAction="#completarVenta"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 30;"/>
        </HBox>
    </bottom>

</BorderPane>